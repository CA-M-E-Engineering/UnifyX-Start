{
  "manifest_version": 3,
  "name": "UnifyX Kiosk Guard",
  "version": "1.0",
  "minimum_chrome_version": "111",
  "description": "Kiosk mode protection: disable gestures, fullscreen prompts, and keyboard shortcuts",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["fullscreen.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": []
}
