# 目标启动地址 (优先级低于命令行参数 --url)
LAUNCH_URL=http://127.0.0.1:3000

# 浏览器退出后重启；连续快速退出时按 3/6/12/24/30 秒退避
ENABLE_WATCHDOG=true

# 使用浏览器原生 Kiosk 全屏，关闭网页 Fullscreen API 改写。
# Chromium 88–110 设备设为 true；触摸/快捷键防护仍然启用。
NATIVE_FULLSCREEN_ONLY=false

# 是否禁用系统级快捷键 (例如锁定屏幕、切换桌面等，主要针对特定操作系统，如 GNOME)
DISABLE_OS_SHORTCUTS=false

# 可选：Microsoft Edge / Chromium / Chrome for Testing 可执行文件的完整路径，留空时自动查找
# 正式版 Google Chrome 不支持 --load-extension，不可用于此启动器
# BROWSER_PATH=/usr/bin/chromium
# Windows Edge 示例：
# BROWSER_PATH='C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe'

# Chrome 用户数据缓存目录 (用于隔离缓存，默认值: ./app_profile)
USER_DATA_DIR=./kiosk_profile
